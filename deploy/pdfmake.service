[Unit]
Description=pdfmake playground
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pdfmake
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=1234
# Environment=PLAYGROUND_USER=admin
# Environment=PLAYGROUND_PASSWORD=change-me
ExecStart=/usr/bin/node dev-playground/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
